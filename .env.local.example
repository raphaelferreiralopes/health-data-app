# Copy this file to .env.local and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard).

# Public project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service-role key. SERVER-SIDE ONLY -- never prefix with NEXT_PUBLIC_,
# never import supabaseServer.ts from a Client Component. The MVP has no
# login UI yet, so requests aren't authenticated as a real Supabase user;
# this key is what lets the server read data on the demo user's behalf
# despite RLS (see src/app/lib/supabaseServer.ts).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
