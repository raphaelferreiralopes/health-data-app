# Copy this file to .env.local and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard).

# Public project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Public anon key, safe to expose to the browser. Used for login/signup
# (AuthGate) and for reading the signed-in user's session, both in the
# browser (supabaseBrowser.ts) and in Server Components (supabaseServerAuth.ts).
# RLS policies apply to requests made with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service-role key. SERVER-SIDE ONLY -- never prefix with NEXT_PUBLIC_,
# never import supabaseServer.ts from a Client Component. Bypasses RLS; used
# for the Datenbank lab-value queries, which explicitly filter by user id
# instead of relying on RLS (see src/app/lib/supabaseServer.ts).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API key. SERVER-SIDE ONLY -- never prefix with NEXT_PUBLIC_.
# Used by the PDF/photo upload routes (Arztbefund explanation, medication
# extraction) to read data out of uploaded documents (see
# src/app/lib/geminiServer.ts). Get a free key at aistudio.google.com/apikey.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whoop OAuth app credentials. SERVER-SIDE ONLY. Create an app at
# developer.whoop.com/dashboard, set its redirect URI to
# <your-app-url>/api/wearables/whoop/callback (e.g. http://localhost:3010/api/wearables/whoop/callback
# for local dev). Apps work for up to 10 connected members without formal
# review -- see src/app/api/wearables/whoop/.
WHOOP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHOOP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Health API (Fitbit successor) OAuth credentials. SERVER-SIDE ONLY.
# Create a Google Cloud project, enable the Google Health API, create an
# OAuth 2.0 Client ID (Web application type), and set its redirect URI to
# <your-app-url>/api/wearables/fitbit/callback. See
# developers.google.com/health/setup and src/app/api/wearables/fitbit/.
GOOGLE_HEALTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_HEALTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
