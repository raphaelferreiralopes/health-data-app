# Copy this file to .env.local and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard).

# Public project URL, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Public anon key, safe to expose to the browser. Used for login/signup
# (AuthGate) and for reading the signed-in user's session, both in the
# browser (supabaseBrowser.ts) and in Server Components (supabaseServerAuth.ts).
# RLS policies apply to requests made with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service-role key. SERVER-SIDE ONLY -- never prefix with NEXT_PUBLIC_,
# never import supabaseServer.ts from a Client Component. Bypasses RLS; used
# for the Datenbank lab-value queries, which explicitly filter by user id
# instead of relying on RLS (see src/app/lib/supabaseServer.ts).
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key. SERVER-SIDE ONLY -- never prefix with NEXT_PUBLIC_.
# Used by /api/analysis-uploads/extract to read lab values out of uploaded
# PDFs (see src/app/lib/anthropicServer.ts). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
